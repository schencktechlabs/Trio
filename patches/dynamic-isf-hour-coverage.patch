diff --git a/TrioTests/DynamicISFEnableTests.swift b/TrioTests/DynamicISFEnableTests.swift
index 9daebb575..df89d1d39 100644
--- a/TrioTests/DynamicISFEnableTests.swift
+++ b/TrioTests/DynamicISFEnableTests.swift
@@ -45,4 +45,58 @@ import Testing
         let enabled = try await testEnableLogic(percentSamples: 0.7)
         #expect(!enabled)
     }
+
+    // LOCAL PATCH (schencktechlabs): hour-coverage tests
+
+    /// Inserts `samplesPerHour` records into each of the most recent `hours` hours.
+    func testHourCoverage(samplesPerHour: Int, hours: Int) async throws -> Bool {
+        let now = Date()
+
+        try await context.perform {
+            for hour in 0 ..< hours {
+                for sample in 0 ..< samplesPerHour {
+                    let tdd = TDDStored(context: context)
+                    tdd.date = now - Double(hour * 3600 + sample * 300 + 60)
+                    tdd.total = 30
+                    tdd.bolus = 15
+                    tdd.tempBasal = 15
+                    tdd.scheduledBasal = 0
+                }
+            }
+
+            try context.save()
+        }
+
+        return try await BaseTDDStorage.hasSufficientTDD(context: context)
+    }
+
+    @Test("Skipped cycles spread across all 7 days (8 of 12 per hour, 67%) enable Dynamic ISF")
+    func testScatteredSkipsEnable() async throws {
+        let enabled = try await testHourCoverage(samplesPerHour: 8, hours: 168)
+        #expect(enabled)
+    }
+
+    @Test("Exactly half the cycles in every hour (6 of 12) enable Dynamic ISF")
+    func testHalfPerHourEnables() async throws {
+        let enabled = try await testHourCoverage(samplesPerHour: 6, hours: 168)
+        #expect(enabled)
+    }
+
+    @Test("Sparse looping (5 of 12 per hour) keeps Dynamic ISF disabled")
+    func testSparseLoopingDisables() async throws {
+        let enabled = try await testHourCoverage(samplesPerHour: 5, hours: 168)
+        #expect(!enabled)
+    }
+
+    @Test("Full looping for only 5 days (120 of 168 hours) keeps Dynamic ISF disabled")
+    func testTooFewDaysDisables() async throws {
+        let enabled = try await testHourCoverage(samplesPerHour: 12, hours: 120)
+        #expect(!enabled)
+    }
+
+    @Test("Full looping for 126 hours (exactly 75%) enables Dynamic ISF")
+    func testThresholdHoursEnable() async throws {
+        let enabled = try await testHourCoverage(samplesPerHour: 12, hours: 126)
+        #expect(enabled)
+    }
 }
